[TITLE]
LoopBiotek waste stub — minimal EPA SWMM skeleton
;; Intentional skeleton: nodes + link + rain gage placeholders.
;; Expand with QSDsan for process trains; open in EPA SWMM 5.2+ / PySWMM.

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO
START_DATE           01/01/2026
START_TIME           00:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
END_DATE             01/02/2026
END_TIME             00:00:00
REPORT_STEP          00:15:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         0:00:30

[EVAPORATION]
CONSTANT  0.0
DRY_ONLY NO

[RAINGAGES]
;;Name           Format    Interval SCF      Source
RG1              INTENSITY 1:00     1.0      TIMESERIES TS1

[SUBCATCHMENTS]
;;Name           Rain Gage        Outlet           Area     %Imperv  Width    %Slope   CurbLen  SnowPack
S1               RG1              J1               1        50       100      1.0      0

[SUBAREAS]
;;Subcatchment   N-Imperv   N-Perv     S-Imperv   S-Perv     PctZero    RouteTo    PctRouted
S1               0.01       0.1        0.05       0.05       25         OUTLET

[INFILTRATION]
;;Subcatchment   MaxRate    MinRate    Decay      DryTime    MaxInfil
S1               3.0        0.5        4          7          0

[JUNCTIONS]
;;Name           Elevation  MaxDepth   InitDepth  SurDepth   Aponded
J1               100        5          0          0          0
J2               99         5          0          0          0

[OUTFALLS]
;;Name           Elevation  Type       Stage Data       Gated    Route To
OUT1             98         FREE                        NO

[CONDUITS]
;;Name           From Node        To Node          Length     Roughness  InOffset   OutOffset  InitFlow   MaxFlow
C1               J1               J2               50         0.01       0          0          0          0
C2               J2               OUT1             30         0.01       0          0          0          0

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels    Culvert
C1               CIRCULAR     1.0              0          0          0          1
C2               CIRCULAR     1.0              0          0          0          1

[TIMESERIES]
;;Name           Date       Time       Value
TS1                         0:00       0.0
TS1                         1:00       0.1
TS1                         2:00       0.0

[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[TAGS]

[MAP]
DIMENSIONS 0 0 100 100
UNITS      None

[COORDINATES]
;;Node           X-Coord            Y-Coord
J1               0                  0
J2               50                 0
OUT1             80                 0

[VERTICES]

[Polygons]
;;Subcatchment   X-Coord            Y-Coord
S1               0                  20
S1               40                 20
S1               40                 60
S1               0                  60

[SYMBOLS]
;;Gage           X-Coord            Y-Coord
RG1              10                 70

